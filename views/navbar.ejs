<% if (user) { %>
<nav class="navbar">
  <a href="/" class="brand">Flotek Overtime</a>
  <div class="nav-links">
    <% if (user.role === 'manager') { %>
      <a href="/dashboard">My Overtime</a>
      <a href="/manager">Manager</a>
    <% } else if (user.role === 'payroll') { %>
      <a href="/payroll">Payroll</a>
      <a href="/payroll/import">Import</a>
    <% } else { %>
      <a href="/dashboard">Dashboard</a>
    <% } %>
    <span style="opacity:0.7">|</span>
    <span style="font-size:0.85rem; opacity:0.8"><%= user.name %></span>
    <a href="/logout">Logout</a>
  </div>
</nav>
<% } %>
