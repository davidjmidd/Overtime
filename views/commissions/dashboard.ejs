<%- include('../layout-head', { title: 'Commissions' }) %>
<%- include('../navbar') %>
<div class="container">
  <%- include('../flash') %>

  <div class="page-header">
    <h1>My Commissions</h1>
    <div class="filter-bar" style="margin:0;">
      <form method="GET" style="display:flex; gap:0.5rem; align-items:center;">
        <select name="month" onchange="this.form.submit()">
          <% months.forEach(m => { %>
            <option value="<%= m.month %>" <%= activeMonth === m.month ? 'selected' : '' %>><%= m.month %></option>
          <% }) %>
        </select>
      </form>
    </div>
  </div>

  <% if (target) { %>
  <div class="stats">
    <div class="stat-card">
      <div class="stat-value">&pound;<%= totalOneOffGP.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></div>
      <div class="stat-label">One Off GP (Target: &pound;<%= target.one_off_gp_target.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %>)</div>
      <div class="progress-bar"><div class="progress-fill" style="width:<%= Math.min(100, totalOneOffGP / target.one_off_gp_target * 100) %>%; background:<%= totalOneOffGP >= target.one_off_gp_target ? 'var(--success)' : 'var(--plum)' %>;"></div></div>
      <div style="font-size:0.75rem; color:var(--text-light); margin-top:0.25rem;"><%= (totalOneOffGP / target.one_off_gp_target * 100).toFixed(1) %>% of target</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">&pound;<%= totalMRGP.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></div>
      <div class="stat-label">MRGP (Target: &pound;<%= target.mrgp_target.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %>)</div>
      <div class="progress-bar"><div class="progress-fill" style="width:<%= Math.min(100, totalMRGP / target.mrgp_target * 100) %>%; background:<%= totalMRGP >= target.mrgp_target ? 'var(--success)' : 'var(--orange)' %>;"></div></div>
      <div style="font-size:0.75rem; color:var(--text-light); margin-top:0.25rem;"><%= (totalMRGP / target.mrgp_target * 100).toFixed(1) %>% of target</div>
    </div>
    <div class="stat-card" style="border-left:3px solid <%= targetMet ? 'var(--success)' : 'var(--danger)' %>;">
      <div class="stat-value">&pound;<%= qualifiedCommission.toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %></div>
      <div class="stat-label">Qualified Commission</div>
      <% if (!targetMet) { %>
        <div style="font-size:0.75rem; color:var(--danger); margin-top:0.25rem; font-weight:600;">Target not met - commission not payable</div>
      <% } else { %>
        <div style="font-size:0.75rem; color:var(--success); margin-top:0.25rem; font-weight:600;">Target met</div>
      <% } %>
    </div>
    <div class="stat-card" style="border-left:3px solid var(--plum);">
      <div class="stat-value">&pound;<%= inTheBank.toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %></div>
      <div class="stat-label">In the Bank</div>
      <div style="font-size:0.75rem; color:var(--text-light); margin-top:0.25rem;"><%= inTheBankCount %> deal<%= inTheBankCount !== 1 ? 's' : '' %> approved &amp; delivered, awaiting payment</div>
    </div>
  </div>
  <% } else { %>
  <div class="alert alert-error">No targets set for this month. Contact your manager or payroll.</div>
  <% } %>

  <div class="tabs">
    <button class="tab active" onclick="showTab('deals')">Deals (<%= deals.length %>)</button>
    <button class="tab" onclick="showTab('performance')">Performance (6 Months)</button>
    <button class="tab" onclick="showTab('submit')">Submit Deal</button>
  </div>

  <div id="tab-deals" class="tab-content active">
    <div class="card">
      <h2>Deals - <%= activeMonth %></h2>
      <% if (deals.length === 0) { %>
        <div class="empty-state">No deals for this month.</div>
      <% } else { %>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Customer</th>
                <th>New?</th>
                <th>One Off GP</th>
                <th>MRGP</th>
                <th>Contract</th>
                <th>Commission</th>
                <th>Delivered</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% deals.forEach(d => { %>
              <tr<% if (d.rejection_comment) { %> style="background:var(--orange-lightest);"<% } %>>
                <td><%= new Date(d.deal_date).toLocaleDateString('en-GB') %></td>
                <td><%= d.customer_name %></td>
                <td><%= d.is_new_customer ? 'Yes (20%)' : 'No (10%)' %></td>
                <td>&pound;<%= d.one_off_gp.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
                <td>&pound;<%= d.mrgp.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
                <td><%= d.contract_months %>m (<%= d.mrgp_multiplier %>x)</td>
                <td>
                  &pound;<%= (d.total_commission + d.manual_adjustment).toLocaleString('en-GB', {minimumFractionDigits:2}) %>
                  <% if (d.manual_adjustment) { %>
                    <br><span style="font-size:0.75rem; color:var(--text-light);">adj: &pound;<%= d.manual_adjustment.toFixed(2) %></span>
                  <% } %>
                </td>
                <td>
                  <% if (d.project_delivered) { %>
                    <span class="badge badge-paid">Delivered</span>
                  <% } else { %>
                    <span class="badge badge-pending">Pending</span>
                  <% } %>
                </td>
                <td>
                  <% if (d.paid) { %>
                    <span class="badge badge-paid">Paid</span>
                  <% } else if (d.approved && d.project_delivered) { %>
                    <span class="badge" style="background:var(--plum-lightest); color:var(--plum-dark);">In the Bank</span>
                  <% } else if (d.approved) { %>
                    <span class="badge badge-approved">Approved</span>
                  <% } else if (d.rejection_comment) { %>
                    <span class="badge badge-rejected">Returned</span>
                    <div class="rejection-comment"><strong>Manager:</strong> <%= d.rejection_comment %></div>
                  <% } else { %>
                    <span class="badge badge-pending">Pending</span>
                  <% } %>
                </td>
                <td>
                  <% if (!d.approved && !d.paid) { %>
                    <form method="POST" action="/commissions/delete-deal/<%= d.id %>" style="display:inline;">
                      <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete this deal?')">Delete</button>
                    </form>
                  <% } else { %> - <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% if (!targetMet && target) { %>
        <div style="margin-top:0.75rem; padding:0.75rem; background:var(--orange-lightest); border-left:3px solid var(--danger); border-radius:4px; font-size:0.85rem;">
          <strong>Target not met this month.</strong> Commission will not be payable until One Off GP target (&pound;<%= target.one_off_gp_target.toLocaleString('en-GB', {minimumFractionDigits:0}) %>) is reached.
        </div>
        <% } %>
      <% } %>
    </div>
  </div>

  <!-- 6-Month Performance -->
  <div id="tab-performance" class="tab-content">
    <div class="card">
      <h2>Performance Over Last 6 Months</h2>
      <% if (history.length === 0) { %>
        <div class="empty-state">No historical data available.</div>
      <% } else { %>

        <!-- SVG Trend Chart -->
        <%
          const chartW = 680, chartH = 220, padL = 60, padR = 20, padT = 20, padB = 40;
          const plotW = chartW - padL - padR;
          const plotH = chartH - padT - padB;
          const n = history.length;
          const maxGP = Math.max(...history.map(h => Math.max(h.oneOffGP, h.oneOffTarget || 0, h.mrgp)), 1);
          const maxComm = Math.max(...history.map(h => Math.max(h.commission, h.paid)), 1);
          function xPos(i) { return padL + (n > 1 ? (i / (n - 1)) * plotW : plotW / 2); }
          function yGP(v) { return padT + plotH - (v / maxGP * plotH); }
          function yComm(v) { return padT + plotH - (v / maxComm * plotH); }
        %>
        <div style="margin-bottom:1.5rem;">
          <div style="display:flex; gap:1rem; margin-bottom:0.5rem; flex-wrap:wrap;">
            <span style="font-size:0.75rem;"><span style="display:inline-block;width:16px;height:3px;background:var(--plum);vertical-align:middle;margin-right:4px;"></span> One Off GP</span>
            <span style="font-size:0.75rem;"><span style="display:inline-block;width:16px;height:3px;background:var(--plum);vertical-align:middle;margin-right:4px;border-top:2px dashed var(--plum-dark);"></span> GP Target</span>
            <span style="font-size:0.75rem;"><span style="display:inline-block;width:16px;height:3px;background:var(--orange);vertical-align:middle;margin-right:4px;"></span> MRGP</span>
            <span style="font-size:0.75rem;"><span style="display:inline-block;width:12px;height:12px;background:var(--success);border-radius:2px;vertical-align:middle;margin-right:4px;"></span> Commission Paid</span>
            <span style="font-size:0.75rem;"><span style="display:inline-block;width:12px;height:12px;background:var(--plum-lightest);border:1px solid var(--plum);border-radius:2px;vertical-align:middle;margin-right:4px;"></span> In the Bank</span>
          </div>
          <svg viewBox="0 0 <%= chartW %> <%= chartH %>" style="width:100%; max-width:700px; height:auto; font-family:inherit;">
            <!-- Grid lines -->
            <% for (let i = 0; i <= 4; i++) { %>
              <line x1="<%= padL %>" y1="<%= padT + (plotH/4)*i %>" x2="<%= padL + plotW %>" y2="<%= padT + (plotH/4)*i %>" stroke="var(--border)" stroke-width="0.5"/>
              <text x="<%= padL - 6 %>" y="<%= padT + (plotH/4)*i + 4 %>" text-anchor="end" font-size="9" fill="var(--text-light)">&pound;<%= Math.round(maxGP * (1 - i/4) / 1000) %>k</text>
            <% } %>

            <!-- Target line (dashed) -->
            <% if (history.some(h => h.oneOffTarget > 0)) { %>
              <polyline fill="none" stroke="var(--plum-dark)" stroke-width="1.5" stroke-dasharray="4,3"
                points="<%= history.map((h, i) => xPos(i) + ',' + yGP(h.oneOffTarget)).join(' ') %>"/>
            <% } %>

            <!-- One Off GP line -->
            <polyline fill="none" stroke="var(--plum)" stroke-width="2.5"
              points="<%= history.map((h, i) => xPos(i) + ',' + yGP(h.oneOffGP)).join(' ') %>"/>
            <% history.forEach((h, i) => { %>
              <circle cx="<%= xPos(i) %>" cy="<%= yGP(h.oneOffGP) %>" r="4" fill="<%= h.targetMet ? 'var(--success)' : 'var(--danger)' %>" stroke="white" stroke-width="1.5"/>
            <% }) %>

            <!-- MRGP line -->
            <polyline fill="none" stroke="var(--orange)" stroke-width="2"
              points="<%= history.map((h, i) => xPos(i) + ',' + yGP(h.mrgp)).join(' ') %>"/>
            <% history.forEach((h, i) => { %>
              <circle cx="<%= xPos(i) %>" cy="<%= yGP(h.mrgp) %>" r="3" fill="var(--orange)" stroke="white" stroke-width="1"/>
            <% }) %>

            <!-- Commission bars (paid + in bank) -->
            <% const barW = Math.min(30, plotW / n * 0.4); %>
            <% history.forEach((h, i) => { %>
              <% const totalBar = h.paid + h.inTheBank; const barMax = maxGP; %>
              <% if (h.inTheBank > 0) { %>
                <rect x="<%= xPos(i) - barW/2 %>" y="<%= yGP(totalBar) %>" width="<%= barW %>" height="<%= Math.max(1, plotH - (yGP(totalBar) - padT)) %>" fill="var(--plum-lightest)" stroke="var(--plum)" stroke-width="0.5" rx="2" opacity="0.7"/>
              <% } %>
              <% if (h.paid > 0) { %>
                <rect x="<%= xPos(i) - barW/2 %>" y="<%= yGP(h.paid) %>" width="<%= barW %>" height="<%= Math.max(1, plotH - (yGP(h.paid) - padT)) %>" fill="var(--success)" rx="2" opacity="0.8"/>
              <% } %>
            <% }) %>

            <!-- Month labels -->
            <% history.forEach((h, i) => { %>
              <text x="<%= xPos(i) %>" y="<%= chartH - 8 %>" text-anchor="middle" font-size="10" fill="var(--text-light)">
                <%= h.month.split(' ')[0].substring(0,3) %> '<%= h.month.split(' ')[1].substring(2) %>
              </text>
              <% if (!h.targetMet && h.oneOffTarget > 0) { %>
                <text x="<%= xPos(i) %>" y="<%= chartH %>" text-anchor="middle" font-size="8" fill="var(--danger)" font-weight="600">MISSED</text>
              <% } %>
            <% }) %>
          </svg>
        </div>

        <!-- Summary stats for the 6 months -->
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr)); gap:0.75rem; margin-bottom:1.5rem;">
          <div style="text-align:center; padding:0.75rem; background:var(--plum-lightest); border-radius:8px;">
            <div style="font-size:1.1rem; font-weight:700;">&pound;<%= historyTotals.qualifiedComm.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></div>
            <div style="font-size:0.75rem; color:var(--text-light);">Qualified Commission</div>
          </div>
          <div style="text-align:center; padding:0.75rem; background:var(--success-light, #e8f5e9); border-radius:8px;">
            <div style="font-size:1.1rem; font-weight:700;">&pound;<%= historyTotals.paid.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></div>
            <div style="font-size:0.75rem; color:var(--text-light);">Total Paid</div>
          </div>
          <div style="text-align:center; padding:0.75rem; background:var(--plum-lightest); border-radius:8px;">
            <div style="font-size:1.1rem; font-weight:700;">&pound;<%= historyTotals.inTheBank.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></div>
            <div style="font-size:0.75rem; color:var(--text-light);">In the Bank</div>
          </div>
          <div style="text-align:center; padding:0.75rem; border-radius:8px; background:<%= historyTotals.monthsMet === historyTotals.monthsTotal ? 'var(--success-light, #e8f5e9)' : 'var(--orange-lightest)' %>;">
            <div style="font-size:1.1rem; font-weight:700;"><%= historyTotals.monthsMet %>/<%= historyTotals.monthsTotal %></div>
            <div style="font-size:0.75rem; color:var(--text-light);">Months Target Met</div>
          </div>
        </div>

        <!-- Monthly breakdown table -->
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Month</th>
                <th>Deals</th>
                <th>One Off GP</th>
                <th>Target</th>
                <th>% Target</th>
                <th>MRGP</th>
                <th>Target</th>
                <th>Commission</th>
                <th>Qualified</th>
                <th>In Bank</th>
                <th>Paid</th>
              </tr>
            </thead>
            <tbody>
              <% history.forEach(h => { %>
              <tr style="<%= !h.targetMet && h.oneOffTarget > 0 ? 'opacity:0.6;' : '' %>">
                <td>
                  <%= h.month %>
                  <% if (h.targetMet) { %>
                    <span style="color:var(--success); font-size:0.8rem;" title="Target met">&#10003;</span>
                  <% } else if (h.oneOffTarget > 0) { %>
                    <span style="color:var(--danger); font-size:0.8rem;" title="Target missed">&#10007;</span>
                  <% } %>
                </td>
                <td><%= h.dealCount %></td>
                <td>&pound;<%= h.oneOffGP.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>&pound;<%= h.oneOffTarget.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>
                  <% if (h.oneOffTarget > 0) { %>
                    <span class="badge <%= h.oneOffPct >= 100 ? 'badge-paid' : (h.oneOffPct >= 75 ? 'badge-approved' : 'badge-pending') %>"><%= h.oneOffPct.toFixed(0) %>%</span>
                  <% } else { %>-<% } %>
                </td>
                <td>&pound;<%= h.mrgp.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>&pound;<%= h.mrgpTarget.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>&pound;<%= h.commission.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
                <td style="font-weight:600;">
                  <% if (h.targetMet) { %>
                    &pound;<%= h.qualifiedComm.toLocaleString('en-GB', {minimumFractionDigits:2}) %>
                  <% } else if (h.oneOffTarget > 0) { %>
                    <span style="color:var(--danger);">&pound;0.00</span>
                  <% } else { %>
                    -
                  <% } %>
                </td>
                <td>&pound;<%= h.inTheBank.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
                <td>&pound;<%= h.paid.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
              </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr style="font-weight:700; background:var(--plum-lightest);">
                <td>Total (6 Months)</td>
                <td><%= historyTotals.deals %></td>
                <td>&pound;<%= historyTotals.oneOffGP.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>&pound;<%= historyTotals.oneOffTarget.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>
                  <% if (historyTotals.oneOffTarget > 0) { %>
                    <%= (historyTotals.oneOffGP / historyTotals.oneOffTarget * 100).toFixed(0) %>%
                  <% } else { %>-<% } %>
                </td>
                <td>&pound;<%= historyTotals.mrgp.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>&pound;<%= historyTotals.mrgpTarget.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>&pound;<%= historyTotals.commission.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
                <td>&pound;<%= historyTotals.qualifiedComm.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
                <td>&pound;<%= historyTotals.inTheBank.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
                <td>&pound;<%= historyTotals.paid.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
        <p style="margin-top:0.75rem; font-size:0.8rem; color:var(--text-light);">
          Monthly target must be met to qualify for commission. Months where target is missed show &pound;0 qualified commission.
          <br>"In the Bank" = approved &amp; delivered deals awaiting payment.
        </p>
      <% } %>
    </div>
  </div>

  <div id="tab-submit" class="tab-content">
    <div class="card" style="max-width:650px;">
      <h2>Submit Deal</h2>
      <form method="POST" action="/commissions/submit-deal">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0 1rem;">
          <div class="form-group">
            <label>Customer Name *</label>
            <input type="text" name="customer_name" required placeholder="e.g. Acme Ltd">
          </div>
          <div class="form-group">
            <label>New Customer?</label>
            <select name="is_new_customer">
              <option value="0">No (10% commission)</option>
              <option value="1">Yes (20% commission)</option>
            </select>
          </div>
          <div class="form-group">
            <label>Deal Date *</label>
            <input type="date" name="deal_date" required>
          </div>
          <div class="form-group">
            <label>Approved By *</label>
            <select name="approver_email" required>
              <option value="">Select manager</option>
              <% managers.forEach(m => { %>
                <option value="<%= m.email %>"><%= m.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>One Off GP (&pound;)</label>
            <input type="number" name="one_off_gp" step="0.01" min="0" value="0" placeholder="0.00">
          </div>
          <div class="form-group">
            <label>MRGP (&pound;/month)</label>
            <input type="number" name="mrgp" step="0.01" min="0" value="0" placeholder="0.00">
          </div>
          <div class="form-group">
            <label>Contract Length (months)</label>
            <select name="contract_months">
              <option value="12">12 months (1x MRGP)</option>
              <option value="24">24 months (2x MRGP)</option>
              <option value="36">36 months (2x MRGP)</option>
              <option value="60">60 months (3x MRGP)</option>
            </select>
          </div>
          <div class="form-group">
            <label>Project Delivered?</label>
            <select name="project_delivered">
              <option value="0">No - not yet payable</option>
              <option value="1">Yes - payable</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea name="description" rows="2" style="width:100%; padding:0.6rem; border:1px solid var(--border); border-radius:6px; font-family:inherit; resize:vertical;" placeholder="Brief deal description"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Submit Deal</button>
      </form>
      <div style="margin-top:1.5rem; padding-top:1rem; border-top:1px solid var(--border); font-size:0.85rem; color:var(--text-light);">
        <strong>Commission Rates:</strong><br>
        Target = Monthly Salary &times; 3.5 (One Off GP) | MRGP Target = One Off GP Target &times; 6.25%<br>
        One Off GP: 10% (20% for new customers) | MRGP: 1x for 12m, 2x for 13-36m, 3x for 60m+<br>
        Monthly target must be met to qualify. Payable once project is delivered.
      </div>
    </div>
  </div>
</div>

<style>
.progress-bar { height:6px; background:var(--border); border-radius:3px; margin-top:0.5rem; overflow:hidden; }
.progress-fill { height:100%; border-radius:3px; transition:width 0.3s; }
</style>
<script>
function showTab(name) {
  document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
  document.getElementById('tab-' + name).classList.add('active');
  event.target.classList.add('active');
}
</script>
</body></html>
