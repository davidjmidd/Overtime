<%- include('../layout-head', { title: 'Commission Manager' }) %>
<%- include('../navbar') %>
<div class="container">
  <%- include('../flash') %>

  <div class="page-header">
    <h1>Commission Manager</h1>
    <div class="filter-bar" style="margin:0;">
      <form method="GET" style="display:flex; gap:0.5rem; align-items:center;">
        <select name="month" onchange="this.form.submit()">
          <% months.forEach(m => { %>
            <option value="<%= m.month %>" <%= activeMonth === m.month ? 'selected' : '' %>><%= m.month %></option>
          <% }) %>
        </select>
      </form>
    </div>
  </div>

  <!-- Team KPI Summary -->
  <div class="stats">
    <div class="stat-card">
      <div class="stat-value"><%= teamKPIs.length %></div>
      <div class="stat-label">Team Members</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= pendingDeals.length %></div>
      <div class="stat-label">Pending Approval</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">&pound;<%= teamTotalComm.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></div>
      <div class="stat-label">Total Commission</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">&pound;<%= teamDeliveredComm.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></div>
      <div class="stat-label">Payable (Delivered)</div>
    </div>
  </div>

  <div class="tabs">
    <button class="tab active" onclick="showTab('kpi')">Team KPIs</button>
    <button class="tab" onclick="showTab('performance')">Performance (6 Months)</button>
    <button class="tab" onclick="showTab('pending')">Pending Approval (<%= pendingDeals.length %>)</button>
    <button class="tab" onclick="showTab('all-deals')">All Deals - <%= activeMonth %></button>
  </div>

  <!-- KPI Dashboard -->
  <div id="tab-kpi" class="tab-content active">
    <% if (teamKPIs.length === 0) { %>
      <div class="card"><div class="empty-state">No commission data for this month.</div></div>
    <% } else { %>
      <% teamKPIs.forEach(k => { %>
      <div class="card">
        <h2 style="margin-bottom:0.75rem;"><%= k.name %></h2>
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:1rem; margin-bottom:1rem;">
          <div>
            <div style="font-size:0.8rem; color:var(--text-light);">One Off GP</div>
            <div style="font-size:1.1rem; font-weight:600;">&pound;<%= k.totalOneOff.toLocaleString('en-GB', {minimumFractionDigits:0}) %></div>
            <% if (k.target) { %>
              <div class="progress-bar"><div class="progress-fill" style="width:<%= Math.min(100, k.oneOffPct) %>%; background:<%= k.oneOffPct >= 100 ? 'var(--success)' : 'var(--plum)' %>;"></div></div>
              <div style="font-size:0.75rem; color:var(--text-light);"><%= k.oneOffPct.toFixed(1) %>% of &pound;<%= k.target.one_off_gp_target.toLocaleString('en-GB', {minimumFractionDigits:0}) %></div>
            <% } %>
          </div>
          <div>
            <div style="font-size:0.8rem; color:var(--text-light);">MRGP</div>
            <div style="font-size:1.1rem; font-weight:600;">&pound;<%= k.totalMRGP.toLocaleString('en-GB', {minimumFractionDigits:0}) %></div>
            <% if (k.target) { %>
              <div class="progress-bar"><div class="progress-fill" style="width:<%= Math.min(100, k.mrgpPct) %>%; background:<%= k.mrgpPct >= 100 ? 'var(--success)' : 'var(--orange)' %>;"></div></div>
              <div style="font-size:0.75rem; color:var(--text-light);"><%= k.mrgpPct.toFixed(1) %>% of &pound;<%= k.target.mrgp_target.toLocaleString('en-GB', {minimumFractionDigits:0}) %></div>
            <% } %>
          </div>
          <div>
            <div style="font-size:0.8rem; color:var(--text-light);">Total Commission</div>
            <div style="font-size:1.1rem; font-weight:600;">&pound;<%= k.totalComm.toLocaleString('en-GB', {minimumFractionDigits:2}) %></div>
          </div>
          <div>
            <div style="font-size:0.8rem; color:var(--text-light);">Payable</div>
            <div style="font-size:1.1rem; font-weight:600;">&pound;<%= k.deliveredComm.toLocaleString('en-GB', {minimumFractionDigits:2}) %></div>
            <div style="font-size:0.75rem; color:var(--text-light);"><%= k.dealCount %> deals (<%= k.approvedCount %> approved, <%= k.pendingCount %> pending)</div>
          </div>
        </div>
      </div>
      <% }) %>
    <% } %>
  </div>

  <!-- 6-Month Performance -->
  <div id="tab-performance" class="tab-content">
    <!-- Team Aggregate -->
    <div class="card">
      <h2>Team Performance - Last 6 Months</h2>
      <% if (last6Months.length === 0) { %>
        <div class="empty-state">No historical data available.</div>
      <% } else { %>

        <!-- SVG Trend Chart -->
        <%
          const mChartW = 680, mChartH = 220, mPadL = 60, mPadR = 20, mPadT = 20, mPadB = 40;
          const mPlotW = mChartW - mPadL - mPadR;
          const mPlotH = mChartH - mPadT - mPadB;
          const mN = teamMonthlyAgg.length;
          const mMaxGP = Math.max(...teamMonthlyAgg.map(m => Math.max(m.oneOffGP, m.oneOffTarget || 0, m.mrgp)), 1);
          function mXPos(i) { return mPadL + (mN > 1 ? (i / (mN - 1)) * mPlotW : mPlotW / 2); }
          function mYGP(v) { return mPadT + mPlotH - (v / mMaxGP * mPlotH); }
        %>
        <div style="margin-bottom:1.5rem;">
          <div style="display:flex; gap:1rem; margin-bottom:0.5rem; flex-wrap:wrap;">
            <span style="font-size:0.75rem;"><span style="display:inline-block;width:16px;height:3px;background:var(--plum);vertical-align:middle;margin-right:4px;"></span> One Off GP</span>
            <span style="font-size:0.75rem;"><span style="display:inline-block;width:16px;height:3px;background:var(--plum);vertical-align:middle;margin-right:4px;border-top:2px dashed var(--plum-dark);"></span> GP Target</span>
            <span style="font-size:0.75rem;"><span style="display:inline-block;width:16px;height:3px;background:var(--orange);vertical-align:middle;margin-right:4px;"></span> MRGP</span>
            <span style="font-size:0.75rem;"><span style="display:inline-block;width:12px;height:12px;background:var(--success);border-radius:2px;vertical-align:middle;margin-right:4px;"></span> Paid</span>
            <span style="font-size:0.75rem;"><span style="display:inline-block;width:12px;height:12px;background:var(--plum-lightest);border:1px solid var(--plum);border-radius:2px;vertical-align:middle;margin-right:4px;"></span> In the Bank</span>
          </div>
          <svg viewBox="0 0 <%= mChartW %> <%= mChartH %>" style="width:100%; max-width:700px; height:auto; font-family:inherit;">
            <% for (let i = 0; i <= 4; i++) { %>
              <line x1="<%= mPadL %>" y1="<%= mPadT + (mPlotH/4)*i %>" x2="<%= mPadL + mPlotW %>" y2="<%= mPadT + (mPlotH/4)*i %>" stroke="var(--border)" stroke-width="0.5"/>
              <text x="<%= mPadL - 6 %>" y="<%= mPadT + (mPlotH/4)*i + 4 %>" text-anchor="end" font-size="9" fill="var(--text-light)">&pound;<%= Math.round(mMaxGP * (1 - i/4) / 1000) %>k</text>
            <% } %>
            <% if (teamMonthlyAgg.some(m => m.oneOffTarget > 0)) { %>
              <polyline fill="none" stroke="var(--plum-dark)" stroke-width="1.5" stroke-dasharray="4,3"
                points="<%= teamMonthlyAgg.map((m, i) => mXPos(i) + ',' + mYGP(m.oneOffTarget)).join(' ') %>"/>
            <% } %>
            <polyline fill="none" stroke="var(--plum)" stroke-width="2.5"
              points="<%= teamMonthlyAgg.map((m, i) => mXPos(i) + ',' + mYGP(m.oneOffGP)).join(' ') %>"/>
            <% teamMonthlyAgg.forEach((m, i) => { %>
              <circle cx="<%= mXPos(i) %>" cy="<%= mYGP(m.oneOffGP) %>" r="4" fill="var(--plum)" stroke="white" stroke-width="1.5"/>
            <% }) %>
            <polyline fill="none" stroke="var(--orange)" stroke-width="2"
              points="<%= teamMonthlyAgg.map((m, i) => mXPos(i) + ',' + mYGP(m.mrgp)).join(' ') %>"/>
            <% teamMonthlyAgg.forEach((m, i) => { %>
              <circle cx="<%= mXPos(i) %>" cy="<%= mYGP(m.mrgp) %>" r="3" fill="var(--orange)" stroke="white" stroke-width="1"/>
            <% }) %>
            <% const mBarW = Math.min(30, mPlotW / mN * 0.4); %>
            <% teamMonthlyAgg.forEach((m, i) => { %>
              <% if (m.inTheBank > 0) { %>
                <rect x="<%= mXPos(i) - mBarW/2 %>" y="<%= mYGP(m.paid + m.inTheBank) %>" width="<%= mBarW %>" height="<%= Math.max(1, mPlotH - (mYGP(m.paid + m.inTheBank) - mPadT)) %>" fill="var(--plum-lightest)" stroke="var(--plum)" stroke-width="0.5" rx="2" opacity="0.7"/>
              <% } %>
              <% if (m.paid > 0) { %>
                <rect x="<%= mXPos(i) - mBarW/2 %>" y="<%= mYGP(m.paid) %>" width="<%= mBarW %>" height="<%= Math.max(1, mPlotH - (mYGP(m.paid) - mPadT)) %>" fill="var(--success)" rx="2" opacity="0.8"/>
              <% } %>
            <% }) %>
            <% teamMonthlyAgg.forEach((m, i) => { %>
              <text x="<%= mXPos(i) %>" y="<%= mChartH - 8 %>" text-anchor="middle" font-size="10" fill="var(--text-light)">
                <%= m.month.split(' ')[0].substring(0,3) %> '<%= m.month.split(' ')[1].substring(2) %>
              </text>
            <% }) %>
          </svg>
        </div>

        <!-- Team summary stats -->
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr)); gap:0.75rem; margin-bottom:1.5rem;">
          <div style="text-align:center; padding:0.75rem; background:var(--plum-lightest); border-radius:8px;">
            <div style="font-size:1.1rem; font-weight:700;">&pound;<%= teamAggTotals.qualifiedComm.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></div>
            <div style="font-size:0.75rem; color:var(--text-light);">Qualified Commission</div>
          </div>
          <div style="text-align:center; padding:0.75rem; background:#e8f5e9; border-radius:8px;">
            <div style="font-size:1.1rem; font-weight:700;">&pound;<%= teamAggTotals.paid.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></div>
            <div style="font-size:0.75rem; color:var(--text-light);">Total Paid</div>
          </div>
          <div style="text-align:center; padding:0.75rem; background:var(--plum-lightest); border-radius:8px;">
            <div style="font-size:1.1rem; font-weight:700;">&pound;<%= teamAggTotals.inTheBank.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></div>
            <div style="font-size:0.75rem; color:var(--text-light);">In the Bank</div>
          </div>
        </div>

        <!-- Team aggregate table -->
        <div class="table-wrapper" style="margin-bottom:1.5rem;">
          <table>
            <thead>
              <tr>
                <th>Month</th>
                <th>Deals</th>
                <th>One Off GP</th>
                <th>Target</th>
                <th>% Target</th>
                <th>MRGP</th>
                <th>Target</th>
                <th>Commission</th>
                <th>Qualified</th>
                <th>In Bank</th>
                <th>Paid</th>
              </tr>
            </thead>
            <tbody>
              <% teamMonthlyAgg.forEach(m => { %>
              <tr>
                <td><%= m.month %></td>
                <td><%= m.dealCount %></td>
                <td>&pound;<%= m.oneOffGP.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>&pound;<%= m.oneOffTarget.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>
                  <% if (m.oneOffTarget > 0) { %>
                    <span class="badge <%= (m.oneOffGP/m.oneOffTarget*100) >= 100 ? 'badge-paid' : ((m.oneOffGP/m.oneOffTarget*100) >= 75 ? 'badge-approved' : 'badge-pending') %>"><%= (m.oneOffGP/m.oneOffTarget*100).toFixed(0) %>%</span>
                  <% } else { %>-<% } %>
                </td>
                <td>&pound;<%= m.mrgp.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>&pound;<%= m.mrgpTarget.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>&pound;<%= m.commission.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
                <td style="font-weight:600;">&pound;<%= m.qualifiedComm.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
                <td>&pound;<%= m.inTheBank.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
                <td>&pound;<%= m.paid.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
              </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr style="font-weight:700; background:var(--plum-lightest);">
                <td>Total</td>
                <td><%= teamAggTotals.deals %></td>
                <td>&pound;<%= teamAggTotals.oneOffGP.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>&pound;<%= teamAggTotals.oneOffTarget.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td><% if (teamAggTotals.oneOffTarget > 0) { %><%= (teamAggTotals.oneOffGP/teamAggTotals.oneOffTarget*100).toFixed(0) %>%<% } else { %>-<% } %></td>
                <td>&pound;<%= teamAggTotals.mrgp.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>&pound;<%= teamAggTotals.mrgpTarget.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
                <td>&pound;<%= teamAggTotals.commission.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
                <td>&pound;<%= teamAggTotals.qualifiedComm.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
                <td>&pound;<%= teamAggTotals.inTheBank.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
                <td>&pound;<%= teamAggTotals.paid.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Individual breakdowns -->
    <% teamHistory.forEach(th => { %>
    <div class="card">
      <h2 style="margin-bottom:0.25rem;"><%= th.name %></h2>
      <div style="display:flex; gap:1rem; margin-bottom:0.75rem; font-size:0.85rem; color:var(--text-light);">
        <span>Targets met: <strong><%= th.totals.monthsMet %>/<%= th.monthlyData.length %></strong></span>
        <span>Qualified: <strong>&pound;<%= th.totals.qualifiedComm.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></strong></span>
        <span>In Bank: <strong>&pound;<%= th.totals.inTheBank.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></strong></span>
        <span>Paid: <strong>&pound;<%= th.totals.paid.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></strong></span>
      </div>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Month</th>
              <th>Deals</th>
              <th>One Off GP</th>
              <th>Target</th>
              <th>% Target</th>
              <th>MRGP</th>
              <th>Commission</th>
              <th>Qualified</th>
              <th>In Bank</th>
              <th>Paid</th>
            </tr>
          </thead>
          <tbody>
            <% th.monthlyData.forEach(h => { %>
            <tr style="<%= !h.targetMet && h.oneOffTarget > 0 ? 'opacity:0.6;' : '' %>">
              <td>
                <%= h.month %>
                <% if (h.targetMet) { %>
                  <span style="color:var(--success); font-size:0.8rem;">&#10003;</span>
                <% } else if (h.oneOffTarget > 0) { %>
                  <span style="color:var(--danger); font-size:0.8rem;">&#10007;</span>
                <% } %>
              </td>
              <td><%= h.dealCount %></td>
              <td>&pound;<%= h.oneOffGP.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
              <td>&pound;<%= h.oneOffTarget.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
              <td>
                <% if (h.oneOffTarget > 0) { %>
                  <span class="badge <%= h.oneOffPct >= 100 ? 'badge-paid' : (h.oneOffPct >= 75 ? 'badge-approved' : 'badge-pending') %>"><%= h.oneOffPct.toFixed(0) %>%</span>
                <% } else { %>-<% } %>
              </td>
              <td>&pound;<%= h.mrgp.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
              <td>&pound;<%= h.commission.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
              <td style="font-weight:600;">
                <% if (h.targetMet) { %>
                  &pound;<%= h.qualifiedComm.toLocaleString('en-GB', {minimumFractionDigits:2}) %>
                <% } else if (h.oneOffTarget > 0) { %>
                  <span style="color:var(--danger);">&pound;0.00</span>
                <% } else { %>-<% } %>
              </td>
              <td>&pound;<%= h.inTheBank.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
              <td>&pound;<%= h.paid.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr style="font-weight:700; background:var(--plum-lightest);">
              <td>Total</td>
              <td><%= th.totals.deals %></td>
              <td>&pound;<%= th.totals.oneOffGP.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
              <td>&pound;<%= th.totals.oneOffTarget.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
              <td><% if (th.totals.oneOffTarget > 0) { %><%= (th.totals.oneOffGP/th.totals.oneOffTarget*100).toFixed(0) %>%<% } else { %>-<% } %></td>
              <td>&pound;<%= th.totals.mrgp.toLocaleString('en-GB', {minimumFractionDigits:0, maximumFractionDigits:0}) %></td>
              <td>&pound;<%= th.totals.commission.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
              <td>&pound;<%= th.totals.qualifiedComm.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
              <td>&pound;<%= th.totals.inTheBank.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
              <td>&pound;<%= th.totals.paid.toLocaleString('en-GB', {minimumFractionDigits:2}) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
    <% }) %>
    <p style="font-size:0.8rem; color:var(--text-light); margin-top:0.5rem;">
      Monthly target must be met to qualify for commission. "In the Bank" = approved &amp; delivered, awaiting payment.
    </p>
  </div>

  <!-- Pending Approval -->
  <div id="tab-pending" class="tab-content">
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <h2 style="border:none; margin:0; padding:0;">Pending Commission Approval</h2>
        <% if (pendingDeals.length > 0) { %>
          <form method="POST" action="/commissions/manager/approve-all" style="display:inline;">
            <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Approve all?')">Approve All</button>
          </form>
        <% } %>
      </div>
      <% if (pendingDeals.length === 0) { %>
        <div class="empty-state">No pending deals.</div>
      <% } else { %>
        <%
          const grouped = {};
          pendingDeals.forEach(d => { if (!grouped[d.account_manager_name]) grouped[d.account_manager_name] = []; grouped[d.account_manager_name].push(d); });
        %>
        <% Object.keys(grouped).forEach(name => { %>
          <h3 style="margin:1rem 0 0.5rem; font-size:1rem;"><%= name %></h3>
          <div class="table-wrapper" style="margin-bottom:1rem;">
            <table>
              <thead><tr><th>Date</th><th>Customer</th><th>One Off GP</th><th>MRGP</th><th>Contract</th><th>Commission</th><th>Delivered</th><th>Action</th></tr></thead>
              <tbody>
                <% grouped[name].forEach(d => { %>
                <tr<% if (d.rejection_comment) { %> style="background:var(--orange-lightest);"<% } %>>
                  <td><%= new Date(d.deal_date).toLocaleDateString('en-GB') %></td>
                  <td><%= d.customer_name %><%= d.is_new_customer ? ' (New)' : '' %></td>
                  <td>&pound;<%= d.one_off_gp.toFixed(2) %></td>
                  <td>&pound;<%= d.mrgp.toFixed(2) %></td>
                  <td><%= d.contract_months %>m</td>
                  <td>&pound;<%= d.total_commission.toFixed(2) %></td>
                  <td><%= d.project_delivered ? 'Yes' : 'No' %></td>
                  <td>
                    <div style="display:flex; gap:0.25rem; flex-wrap:wrap;">
                      <form method="POST" action="/commissions/manager/approve/<%= d.id %>" style="display:inline;">
                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                      </form>
                      <button type="button" class="btn btn-warning btn-sm" onclick="openRejectModal(<%= d.id %>, '<%= d.account_manager_name.replace(/'/g, "\\'") %>')">Send Back</button>
                      <button type="button" class="btn btn-outline btn-sm" onclick="openAdjustModal(<%= d.id %>, <%= d.manual_adjustment %>)">Adjust</button>
                      <form method="POST" action="/commissions/manager/toggle-delivered/<%= d.id %>" style="display:inline;">
                        <button type="submit" class="btn btn-sm" style="background:var(--plum-light); color:white;"><%= d.project_delivered ? 'Undeliver' : 'Deliver' %></button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- All Deals for Month -->
  <div id="tab-all-deals" class="tab-content">
    <div class="card">
      <h2>All Deals - <%= activeMonth %></h2>
      <% if (monthDeals.length === 0) { %>
        <div class="empty-state">No deals for this month.</div>
      <% } else { %>
        <div class="table-wrapper">
          <table>
            <thead><tr><th>Staff</th><th>Date</th><th>Customer</th><th>One Off GP</th><th>MRGP</th><th>Contract</th><th>Commission</th><th>Adj</th><th>Delivered</th><th>Status</th></tr></thead>
            <tbody>
              <% monthDeals.forEach(d => { %>
              <tr>
                <td><%= d.account_manager_name %></td>
                <td><%= new Date(d.deal_date).toLocaleDateString('en-GB') %></td>
                <td><%= d.customer_name %><%= d.is_new_customer ? ' (New)' : '' %></td>
                <td>&pound;<%= d.one_off_gp.toFixed(2) %></td>
                <td>&pound;<%= d.mrgp.toFixed(2) %></td>
                <td><%= d.contract_months %>m (<%= d.mrgp_multiplier %>x)</td>
                <td>&pound;<%= d.total_commission.toFixed(2) %></td>
                <td><%= d.manual_adjustment ? '£' + d.manual_adjustment.toFixed(2) : '-' %></td>
                <td><span class="badge <%= d.project_delivered ? 'badge-paid' : 'badge-pending' %>"><%= d.project_delivered ? 'Yes' : 'No' %></span></td>
                <td>
                  <% if (d.paid) { %><span class="badge badge-paid">Paid</span>
                  <% } else if (d.approved) { %><span class="badge badge-approved">Approved</span>
                  <% } else { %><span class="badge badge-pending">Pending</span><% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div class="modal-overlay" id="rejectModal">
  <div class="modal">
    <h3>Send Back for Review</h3>
    <p style="color:var(--text-light); margin-bottom:1rem; font-size:0.9rem;" id="rejectName"></p>
    <form method="POST" id="rejectForm">
      <div class="form-group">
        <label>Comment *</label>
        <textarea name="comment" rows="3" required placeholder="Explain why..." style="width:100%; padding:0.6rem; border:1px solid var(--border); border-radius:6px; font-family:inherit; resize:vertical;"></textarea>
      </div>
      <div style="display:flex; gap:0.5rem;">
        <button type="submit" class="btn btn-warning">Send Back</button>
        <button type="button" class="btn btn-outline" onclick="document.getElementById('rejectModal').classList.remove('active')">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Adjust Modal -->
<div class="modal-overlay" id="adjustModal">
  <div class="modal">
    <h3>Manual Adjustment</h3>
    <form method="POST" id="adjustForm">
      <div class="form-group">
        <label>Adjustment Amount (&pound;)</label>
        <input type="number" name="manual_adjustment" id="adj-amount" step="0.01" placeholder="e.g. 150 or -50">
      </div>
      <div class="form-group">
        <label>Reason</label>
        <input type="text" name="adjustment_reason" placeholder="Reason for adjustment">
      </div>
      <div style="display:flex; gap:0.5rem;">
        <button type="submit" class="btn btn-primary">Apply</button>
        <button type="button" class="btn btn-outline" onclick="document.getElementById('adjustModal').classList.remove('active')">Cancel</button>
      </div>
    </form>
  </div>
</div>

<style>
.progress-bar { height:6px; background:var(--border); border-radius:3px; margin-top:0.5rem; overflow:hidden; }
.progress-fill { height:100%; border-radius:3px; transition:width 0.3s; }
</style>
<script>
function showTab(name) {
  document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
  document.getElementById('tab-' + name).classList.add('active');
  event.target.classList.add('active');
}
function openRejectModal(id, name) {
  document.getElementById('rejectForm').action = '/commissions/manager/reject/' + id;
  document.getElementById('rejectName').textContent = 'Returning deal for: ' + name;
  document.getElementById('rejectModal').classList.add('active');
}
function openAdjustModal(id, current) {
  document.getElementById('adjustForm').action = '/commissions/manager/adjust/' + id;
  document.getElementById('adj-amount').value = current || '';
  document.getElementById('adjustModal').classList.add('active');
}
document.querySelectorAll('.modal-overlay').forEach(m => {
  m.addEventListener('click', function(e) { if (e.target === this) this.classList.remove('active'); });
});
</script>
</body></html>
