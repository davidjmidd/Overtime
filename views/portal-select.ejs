<%- include('layout-head', { title: 'Flotek Portal' }) %>
<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; background:var(--bg);">
  <div style="text-align:center; max-width:700px; padding:2rem;">
    <h1 style="color:var(--primary); font-size:2rem; margin-bottom:0.5rem;">Flotek Portal</h1>
    <p style="color:var(--text-light); margin-bottom:2.5rem;">Select which portal you need to access</p>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem;">
      <a href="/login?portal=overtime" class="portal-card">
        <div class="portal-icon" style="background:var(--plum);">OT</div>
        <h2>Overtime & Nights Away</h2>
        <p>Submit, track and manage overtime claims and nights away reimbursements</p>
      </a>
      <a href="/login?portal=commissions" class="portal-card">
        <div class="portal-icon" style="background:var(--orange);">CM</div>
        <h2>Commissions</h2>
        <p>Track sales performance, commissions against target, and payment status</p>
      </a>
    </div>
  </div>
</div>
<style>
.portal-card {
  display:block; background:var(--card-bg); border-radius:12px; padding:2rem 1.5rem;
  box-shadow:var(--shadow); text-decoration:none; color:var(--text);
  transition: transform 0.2s, box-shadow 0.2s; border:2px solid transparent;
}
.portal-card:hover { transform:translateY(-4px); box-shadow:0 6px 20px rgba(75,28,75,0.15); border-color:var(--plum-light); }
.portal-icon {
  width:60px; height:60px; border-radius:14px; margin:0 auto 1rem;
  display:flex; align-items:center; justify-content:center;
  color:white; font-weight:700; font-size:1.2rem;
}
.portal-card h2 { font-size:1.1rem; margin-bottom:0.5rem; }
.portal-card p { font-size:0.85rem; color:var(--text-light); line-height:1.4; }
@media(max-width:600px) { div[style*="grid-template-columns"] { grid-template-columns:1fr !important; } }
</style>
</body></html>
