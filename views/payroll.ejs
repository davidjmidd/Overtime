<%- include('layout-head', { title: 'Payroll' }) %>
<%- include('navbar') %>
<div class="container">
  <%- include('flash') %>

  <div class="page-header">
    <h1>Payroll Management</h1>
    <a href="/payroll/import" class="btn btn-primary">Import Excel</a>
  </div>

  <!-- Slicer Filters -->
  <%
    function buildQS(overrides) {
      const p = { month: activeMonth, staff: staffFilter, status: statusFilter, ...overrides };
      return Object.entries(p).filter(([k,v]) => v).map(([k,v]) => k + '=' + encodeURIComponent(v)).join('&');
    }
  %>
  <div class="card" style="margin-bottom:1.5rem; padding:1rem 1.25rem;">
    <form method="GET" id="filterForm" style="display:flex; gap:0.75rem; align-items:flex-end; flex-wrap:wrap;">
      <div class="form-group" style="margin-bottom:0; min-width:140px;">
        <label style="font-size:0.75rem; font-weight:600;">Month</label>
        <select name="month" onchange="this.form.submit()">
          <% months.forEach(m => { %>
            <option value="<%= m.month %>" <%= activeMonth === m.month ? 'selected' : '' %>><%= m.month %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group" style="margin-bottom:0; min-width:160px;">
        <label style="font-size:0.75rem; font-weight:600;">Staff Member</label>
        <select name="staff" onchange="this.form.submit()">
          <option value="">All Staff</option>
          <% allStaff.forEach(s => { %>
            <option value="<%= s.submitter_email %>" <%= staffFilter === s.submitter_email ? 'selected' : '' %>><%= s.submitter_name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group" style="margin-bottom:0; min-width:120px;">
        <label style="font-size:0.75rem; font-weight:600;">Status</label>
        <select name="status" onchange="this.form.submit()">
          <option value="" <%= !statusFilter ? 'selected' : '' %>>All</option>
          <option value="approved" <%= statusFilter === 'approved' ? 'selected' : '' %>>Approved (Unpaid)</option>
          <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="paid" <%= statusFilter === 'paid' ? 'selected' : '' %>>Paid</option>
          <option value="unpaid" <%= statusFilter === 'unpaid' ? 'selected' : '' %>>Unpaid</option>
        </select>
      </div>
      <div style="display:flex; gap:0.5rem; align-items:center;">
        <% if (staffFilter || statusFilter) { %>
          <a href="/payroll?month=<%= activeMonth %>" class="btn btn-outline btn-sm">Clear Filters</a>
        <% } %>
        <a href="/payroll/export?<%= buildQS({type:'overtime'}) %>" class="btn btn-outline btn-sm">Export OT CSV</a>
        <a href="/payroll/export?<%= buildQS({type:'nights'}) %>" class="btn btn-outline btn-sm">Export Nights CSV</a>
      </div>
    </form>
  </div>

  <%
    const totalApprovedOT = summary.reduce((s, a) => s + a.approvedOTCost, 0);
    const totalApprovedNA = summary.reduce((s, a) => s + a.approvedNACost, 0);
    const totalUnpaidOT = summary.reduce((s, a) => s + a.unpaidApprovedOTCost, 0);
    const totalUnpaidNA = summary.reduce((s, a) => s + a.unpaidApprovedNACost, 0);
    const totalUnpaidReady = summary.reduce((s, a) => s + a.unpaidReadyOT + a.unpaidReadyNA, 0);
    const totalPaidOT = summary.reduce((s, a) => s + a.paidOTCost, 0);
    const totalPaidNA = summary.reduce((s, a) => s + a.paidNACost, 0);
  %>

  <div class="stats">
    <div class="stat-card">
      <div class="stat-value"><%= summary.length %></div>
      <div class="stat-label">Staff Members</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">&pound;<%= (totalApprovedOT + totalApprovedNA).toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %></div>
      <div class="stat-label">Total Approved Cost</div>
      <div style="font-size:0.75rem; color:var(--text-light);">OT: &pound;<%= totalApprovedOT.toFixed(2) %> | NA: &pound;<%= totalApprovedNA.toFixed(2) %></div>
    </div>
    <div class="stat-card" style="border-left:3px solid var(--plum);">
      <div class="stat-value">&pound;<%= (totalUnpaidOT + totalUnpaidNA).toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %></div>
      <div class="stat-label">Awaiting Payment</div>
      <div style="font-size:0.75rem; color:var(--text-light);"><%= totalUnpaidReady %> entries ready to pay</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">&pound;<%= (totalPaidOT + totalPaidNA).toLocaleString('en-GB', {minimumFractionDigits:2, maximumFractionDigits:2}) %></div>
      <div class="stat-label">Already Paid</div>
    </div>
  </div>

  <div class="tabs">
    <button class="tab active" onclick="showTab('summary')">Staff Summary - <%= activeMonth %></button>
    <button class="tab" onclick="showTab('overtime')">Overtime (<%= overtime.length %>)</button>
    <button class="tab" onclick="showTab('nights')">Nights Away (<%= nights.length %>)</button>
    <button class="tab" onclick="showTab('rates')">Manage Rates</button>
    <button class="tab" onclick="showTab('mark-paid')">Mark as Paid</button>
  </div>

  <!-- Staff Summary (per month) -->
  <div id="tab-summary" class="tab-content active">
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <h2 style="border:none; margin:0; padding:0;">Payroll Review - <%= activeMonth %></h2>
        <a href="/payroll/export?<%= buildQS({type:'overtime'}) %>" class="btn btn-outline btn-sm">Export this view</a>
      </div>
      <% if (summary.length === 0) { %>
        <div class="empty-state">No overtime or nights away data for this month.</div>
      <% } else { %>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>OT Rate</th>
                <th>Hours</th>
                <th>Pending Hrs</th>
                <th>Approved Hrs</th>
                <th>OT Cost</th>
                <th>Nights</th>
                <th>Night Rate</th>
                <th>NA Cost</th>
                <th>Total Cost</th>
                <th>Awaiting Pay</th>
                <th>Paid</th>
              </tr>
            </thead>
            <tbody>
              <% summary.forEach(s => { %>
              <tr>
                <td>
                  <a href="/payroll?<%= buildQS({staff: s.email}) %>" style="color:var(--plum); text-decoration:none; font-weight:500;">
                    <%= s.name %>
                  </a>
                </td>
                <td>&pound;<%= (s.rate || 0).toFixed(2) %>/hr</td>
                <td><%= s.totalHours.toFixed(1) %></td>
                <td>
                  <% if (s.pendingHours > 0) { %>
                    <span style="color:var(--warning-dark);"><%= s.pendingHours.toFixed(1) %></span>
                  <% } else { %>0<% } %>
                </td>
                <td><%= s.approvedHours.toFixed(1) %></td>
                <td>&pound;<%= s.approvedOTCost.toFixed(2) %></td>
                <td><%= s.totalNights %><% if (s.pendingNights > 0) { %> <span style="font-size:0.75rem; color:var(--warning-dark);">(<%= s.pendingNights %> pending)</span><% } %></td>
                <td>&pound;<%= s.naRate.toFixed(2) %></td>
                <td>&pound;<%= s.approvedNACost.toFixed(2) %></td>
                <td style="font-weight:600;">&pound;<%= s.totalCost.toFixed(2) %></td>
                <td>
                  <% const awaitPay = s.unpaidApprovedOTCost + s.unpaidApprovedNACost; %>
                  <% if (awaitPay > 0) { %>
                    <span style="color:var(--plum); font-weight:500;">&pound;<%= awaitPay.toFixed(2) %></span>
                    <br><span style="font-size:0.7rem; color:var(--text-light);"><%= s.unpaidReadyOT + s.unpaidReadyNA %> entries</span>
                  <% } else { %>
                    -
                  <% } %>
                </td>
                <td>
                  <% const paidTotal = s.paidOTCost + s.paidNACost; %>
                  <% if (paidTotal > 0) { %>
                    &pound;<%= paidTotal.toFixed(2) %>
                  <% } else { %>-<% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr style="font-weight:700; background:var(--plum-lightest);">
                <td>Total</td>
                <td></td>
                <td><%= summary.reduce((s,a) => s + a.totalHours, 0).toFixed(1) %></td>
                <td><%= summary.reduce((s,a) => s + a.pendingHours, 0).toFixed(1) %></td>
                <td><%= summary.reduce((s,a) => s + a.approvedHours, 0).toFixed(1) %></td>
                <td>&pound;<%= totalApprovedOT.toFixed(2) %></td>
                <td><%= summary.reduce((s,a) => s + a.totalNights, 0) %></td>
                <td></td>
                <td>&pound;<%= totalApprovedNA.toFixed(2) %></td>
                <td>&pound;<%= (totalApprovedOT + totalApprovedNA).toFixed(2) %></td>
                <td>&pound;<%= (totalUnpaidOT + totalUnpaidNA).toFixed(2) %></td>
                <td>&pound;<%= (totalPaidOT + totalPaidNA).toFixed(2) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
        <p style="margin-top:0.75rem; font-size:0.8rem; color:var(--text-light);">
          OT cost includes 1.5x weekend rate. "Awaiting Pay" = approved but not yet paid. Click a name to filter.
        </p>
      <% } %>
    </div>
  </div>

  <!-- All Overtime (filtered) -->
  <div id="tab-overtime" class="tab-content">
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <h2 style="border:none; margin:0; padding:0;">Overtime - <%= activeMonth %><% if (staffFilter) { %> (<%= overtime[0]?.submitter_name || staffFilter %>)<% } %></h2>
        <span style="font-size:0.85rem; color:var(--text-light);"><%= overtime.length %> entr<%= overtime.length !== 1 ? 'ies' : 'y' %> shown</span>
      </div>
      <% if (overtime.length === 0) { %>
        <div class="empty-state">No overtime entries match the current filters.</div>
      <% } else { %>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>Date</th>
                <th>Hours</th>
                <th>Weekend</th>
                <th>Rate</th>
                <th>Amount</th>
                <th>Client</th>
                <th>Ticket</th>
                <th>Description</th>
                <th>Status</th>
                <th>Paid</th>
              </tr>
            </thead>
            <tbody>
              <% overtime.forEach(e => { %>
                <% const rate = e.overtime_rate || 0; %>
                <% const amount = e.is_weekend ? e.hours * rate * 1.5 : e.hours * rate; %>
              <tr>
                <td><%= e.submitter_name %></td>
                <td><%= new Date(e.date).toLocaleDateString('en-GB') %></td>
                <td><%= e.hours %></td>
                <td><%= e.is_weekend ? 'Yes (1.5x)' : 'No' %></td>
                <td>&pound;<%= rate.toFixed(2) %></td>
                <td>&pound;<%= amount.toFixed(2) %></td>
                <td><%= e.client || '-' %></td>
                <td><%= e.halo_ticket_ref || '-' %></td>
                <td><%= e.description || '-' %></td>
                <td>
                  <% if (e.approved) { %>
                    <span class="badge badge-approved">Approved</span>
                  <% } else { %>
                    <span class="badge badge-pending">Pending</span>
                  <% } %>
                </td>
                <td>
                  <% if (e.paid) { %>
                    <span class="badge badge-paid"><%= e.paid_month %></span>
                  <% } else if (e.approved) { %>
                    <span class="badge" style="background:var(--plum-lightest); color:var(--plum-dark);">Awaiting Pay</span>
                  <% } else { %>
                    -
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- All Nights Away (filtered) -->
  <div id="tab-nights" class="tab-content">
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <h2 style="border:none; margin:0; padding:0;">Nights Away - <%= activeMonth %><% if (staffFilter) { %> (<%= nights[0]?.submitter_name || staffFilter %>)<% } %></h2>
        <span style="font-size:0.85rem; color:var(--text-light);"><%= nights.length %> entr<%= nights.length !== 1 ? 'ies' : 'y' %> shown</span>
      </div>
      <% if (nights.length === 0) { %>
        <div class="empty-state">No nights away entries match the current filters.</div>
      <% } else { %>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>Date</th>
                <th>Description</th>
                <th>Rate</th>
                <th>Status</th>
                <th>Paid</th>
              </tr>
            </thead>
            <tbody>
              <% nights.forEach(e => { %>
              <tr>
                <td><%= e.submitter_name %></td>
                <td><%= new Date(e.date).toLocaleDateString('en-GB') %></td>
                <td><%= e.description || '-' %></td>
                <td>&pound;<%= (e.nights_away_rate || e.rate || 25).toFixed(2) %></td>
                <td>
                  <% if (e.approved) { %>
                    <span class="badge badge-approved">Approved</span>
                  <% } else { %>
                    <span class="badge badge-pending">Pending</span>
                  <% } %>
                </td>
                <td>
                  <% if (e.paid) { %>
                    <span class="badge badge-paid"><%= e.paid_month %></span>
                  <% } else if (e.approved) { %>
                    <span class="badge" style="background:var(--plum-lightest); color:var(--plum-dark);">Awaiting Pay</span>
                  <% } else { %>
                    -
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Manage Rates -->
  <div id="tab-rates" class="tab-content">
    <div class="card">
      <h2>Manage Staff Rates</h2>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>OT Rate (&pound;/hr)</th>
              <th>Field Engineer?</th>
              <th>Night Rate</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
            <tr>
              <form method="POST" action="/payroll/update-rate">
                <input type="hidden" name="user_id" value="<%= u.id %>">
                <td><%= u.name %></td>
                <td><%= u.email %></td>
                <td><%= u.role %></td>
                <td><input type="number" name="overtime_rate" value="<%= u.overtime_rate || 0 %>" step="0.01" min="0" style="width:80px; padding:0.3rem;"></td>
                <td>
                  <select name="is_field_engineer" style="padding:0.3rem;">
                    <option value="0" <%= !u.is_field_engineer ? 'selected' : '' %>>No (&pound;25)</option>
                    <option value="1" <%= u.is_field_engineer ? 'selected' : '' %>>Yes (&pound;50)</option>
                  </select>
                </td>
                <td>&pound;<%= u.is_field_engineer ? '50.00' : '25.00' %></td>
                <td><button type="submit" class="btn btn-primary btn-sm">Save</button></td>
              </form>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Mark as Paid -->
  <div id="tab-mark-paid" class="tab-content">
    <div class="card">
      <h2>Mark Entries as Paid</h2>
      <%
        const unpaidOT = allOvertime.filter(e => !e.paid && e.approved);
        const unpaidNA = allNights.filter(e => !e.paid && e.approved);
      %>
      <% if (unpaidOT.length === 0 && unpaidNA.length === 0) { %>
        <div class="empty-state">No approved unpaid entries found for this month.</div>
      <% } else { %>
        <% if (unpaidOT.length > 0) { %>
          <h3 style="margin:1rem 0 0.5rem; font-size:1rem;">Approved Unpaid Overtime (<%= unpaidOT.length %>)</h3>
          <form method="POST" action="/payroll/mark-paid">
            <input type="hidden" name="type" value="overtime">
            <div class="form-group" style="max-width:300px;">
              <label>Paid Month</label>
              <input type="text" name="paid_month" placeholder="e.g. November 2025" required>
            </div>
            <div class="table-wrapper" style="margin-bottom:1rem;">
              <table>
                <thead>
                  <tr>
                    <th class="checkbox-cell"><input type="checkbox" onclick="toggleAll(this, 'ot-check')"></th>
                    <th>Name</th>
                    <th>Date</th>
                    <th>Hours</th>
                    <th>Weekend</th>
                    <th>Amount</th>
                  </tr>
                </thead>
                <tbody>
                  <% unpaidOT.forEach(e => { %>
                    <% const rate = e.overtime_rate || 0; %>
                    <% const amount = e.is_weekend ? e.hours * rate * 1.5 : e.hours * rate; %>
                  <tr>
                    <td class="checkbox-cell"><input type="checkbox" name="entry_ids" value="<%= e.id %>" class="ot-check"></td>
                    <td><%= e.submitter_name %></td>
                    <td><%= new Date(e.date).toLocaleDateString('en-GB') %></td>
                    <td><%= e.hours %></td>
                    <td><%= e.is_weekend ? 'Yes' : 'No' %></td>
                    <td>&pound;<%= amount.toFixed(2) %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <button type="submit" class="btn btn-success" onclick="return confirm('Mark selected overtime entries as paid?')">Mark Selected as Paid</button>
          </form>
        <% } %>

        <% if (unpaidNA.length > 0) { %>
          <h3 style="margin:1.5rem 0 0.5rem; font-size:1rem;">Approved Unpaid Nights Away (<%= unpaidNA.length %>)</h3>
          <form method="POST" action="/payroll/mark-paid">
            <input type="hidden" name="type" value="nights">
            <div class="form-group" style="max-width:300px;">
              <label>Paid Month</label>
              <input type="text" name="paid_month" placeholder="e.g. November 2025" required>
            </div>
            <div class="table-wrapper" style="margin-bottom:1rem;">
              <table>
                <thead>
                  <tr>
                    <th class="checkbox-cell"><input type="checkbox" onclick="toggleAll(this, 'na-check')"></th>
                    <th>Name</th>
                    <th>Date</th>
                    <th>Rate</th>
                  </tr>
                </thead>
                <tbody>
                  <% unpaidNA.forEach(e => { %>
                  <tr>
                    <td class="checkbox-cell"><input type="checkbox" name="entry_ids" value="<%= e.id %>" class="na-check"></td>
                    <td><%= e.submitter_name %></td>
                    <td><%= new Date(e.date).toLocaleDateString('en-GB') %></td>
                    <td>&pound;<%= (e.nights_away_rate || e.rate || 25).toFixed(2) %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <button type="submit" class="btn btn-success" onclick="return confirm('Mark selected nights away as paid?')">Mark Selected as Paid</button>
          </form>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<script>
function showTab(name) {
  document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
  document.getElementById('tab-' + name).classList.add('active');
  event.target.classList.add('active');
}
function toggleAll(source, className) {
  document.querySelectorAll('.' + className).forEach(cb => cb.checked = source.checked);
}
</script>
</body></html>
