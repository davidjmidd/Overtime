<%- include('layout-head', { title: 'Login' }) %>
<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; background:var(--bg);">
  <div class="login-container">
    <div style="text-align:center; margin-bottom:1.5rem;">
      <div class="portal-icon-sm" style="background:<%= portal === 'commissions' ? 'var(--orange)' : 'var(--plum)' %>;">
        <%= portal === 'commissions' ? 'CM' : 'OT' %>
      </div>
      <h1><%= portal === 'commissions' ? 'Commissions' : 'Overtime & Nights Away' %></h1>
      <p class="subtitle">Sign in with your Flotek email</p>
    </div>
    <%- include('flash') %>
    <form method="POST" action="/login">
      <input type="hidden" name="portal" value="<%= portal %>">
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="firstname.lastname@flotek.io" required>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Your first name" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Sign In</button>
    </form>
    <p style="text-align:center; margin-top:1rem;"><a href="/" style="color:var(--text-light); font-size:0.85rem;">Back to portal selection</a></p>
  </div>
</div>
<style>
.portal-icon-sm {
  width:48px; height:48px; border-radius:12px; margin:0 auto 0.75rem;
  display:flex; align-items:center; justify-content:center;
  color:white; font-weight:700; font-size:1rem;
}
</style>
</body></html>
